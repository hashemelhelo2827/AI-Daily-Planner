# Flask secret key - CHANGE this before deploying anywhere public.
SECRET_KEY=super-secret-key-change-me

# API keys - add at least one. The more you add, the more resilient the agent is to rate limits.

GEMINI_API_KEY=your_key
# GEMINI_API_KEY2=second_key
GROQ_API_KEY=your_key
MISTRAL_API_KEY=your_key

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_ALT_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_STRONG_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=mistral-small-2603
